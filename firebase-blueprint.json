{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile information isolated from public queries",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 2000 },
        "bio": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "UserRole": {
      "title": "UserRole",
      "description": "Role-based access control record managed exclusively by administrators",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "editor", "user"] },
        "assignedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "updatedAt"]
    },
    "AdminInvite": {
      "title": "AdminInvite",
      "description": "Email-based pre-authorized admin or editor role grant",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "editor"] },
        "note": { "type": "string", "maxLength": 150 },
        "assignedBy": { "type": "string", "maxLength": 128 },
        "assignedByEmail": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "assignedBy", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Islamic knowledge category for articles and questions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 140 },
        "description": { "type": "string", "maxLength": 600 },
        "type": { "type": "string", "enum": ["both", "article", "question"] },
        "icon": { "type": "string", "maxLength": 60 },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "type", "order", "isActive", "createdAt", "updatedAt"]
    },
    "Author": {
      "title": "Author",
      "description": "Islamic scholar, Mufti, or writer profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "title": { "type": "string", "maxLength": 150 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 160 },
        "photoURL": { "type": "string", "maxLength": 2000 },
        "bio": { "type": "string", "maxLength": 3000 },
        "qualifications": { "type": "string", "maxLength": 1500 },
        "specialties": { "type": "string", "maxLength": 500 },
        "totalPublications": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "bio", "qualifications", "isActive", "createdAt", "updatedAt"]
    },
    "Article": {
      "title": "Article",
      "description": "Islamic article with rich content, Arabic quotes, and references",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 240 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 240 },
        "excerpt": { "type": "string", "maxLength": 600 },
        "content": { "type": "string", "minLength": 10, "maxLength": 60000 },
        "arabicQuote": { "type": "string", "maxLength": 4000 },
        "quranHadithRefs": { "type": "string", "maxLength": 2000 },
        "coverImage": { "type": "string", "maxLength": 2000 },
        "categoryId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "categoryName": { "type": "string", "maxLength": 120 },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "maxLength": 150 },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "isFeatured": { "type": "boolean" },
        "readingTimeMinutes": { "type": "number" },
        "viewCount": { "type": "number" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "slug", "excerpt", "content", "categoryId", "categoryName", "authorId", "authorName", "status", "isFeatured", "readingTimeMinutes", "viewCount", "createdAt", "updatedAt"]
    },
    "Question": {
      "title": "Question",
      "description": "Public Islamic question and scholarly answer record (no PII stored here)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 3, "maxLength": 260 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 260 },
        "questionText": { "type": "string", "minLength": 5, "maxLength": 10000 },
        "askerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "categoryId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "categoryName": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "published"] },
        "isFeatured": { "type": "boolean" },
        "answerText": { "type": "string", "maxLength": 30000 },
        "arabicReferences": { "type": "string", "maxLength": 5000 },
        "quranHadithRefs": { "type": "string", "maxLength": 3000 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 150 },
        "viewCount": { "type": "number" },
        "submittedByUid": { "type": "string", "maxLength": 128 },
        "answeredAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "slug", "questionText", "askerName", "categoryId", "categoryName", "status", "isFeatured", "viewCount", "createdAt", "updatedAt"]
    },
    "QuestionContact": {
      "title": "QuestionContact",
      "description": "Isolated PII contact information for question submitters readable only by staff",
      "type": "object",
      "properties": {
        "questionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "contactInfo": { "type": "string", "maxLength": 200 },
        "submittedByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["questionId", "contactInfo", "createdAt"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "User saved article or favorite question",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemType": { "type": "string", "enum": ["article", "question"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 260 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 260 },
        "categoryName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "itemId", "itemType", "title", "slug", "createdAt"]
    },
    "ReadingHistory": {
      "title": "ReadingHistory",
      "description": "User reading history entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemType": { "type": "string", "enum": ["article", "question"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 260 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 260 },
        "categoryName": { "type": "string", "maxLength": 120 },
        "viewedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "itemId", "itemType", "title", "slug", "viewedAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Dynamic website, prayer, donation, and CMS page configuration",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["updatedAt"]
    },
    "SiteStats": {
      "title": "SiteStats",
      "description": "Aggregate website visit statistics",
      "type": "object",
      "properties": {
        "totalVisits": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["totalVisits", "updatedAt"]
    },
    "PageView": {
      "title": "PageView",
      "description": "Individual page view record for analytics",
      "type": "object",
      "properties": {
        "path": { "type": "string", "maxLength": 300 },
        "title": { "type": "string", "maxLength": 260 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["path", "createdAt"]
    },
    "Donation": {
      "title": "Donation",
      "description": "Donation transaction and official receipt record (without PII)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "receiptNo": { "type": "string", "minLength": 4, "maxLength": 40 },
        "donorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["bkash", "nagad", "rocket", "bank"] },
        "transactionId": { "type": "string", "minLength": 2, "maxLength": 80 },
        "senderLastDigits": { "type": "string", "maxLength": 12 },
        "purpose": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "submittedByUid": { "type": "string", "maxLength": 128 },
        "verifiedBy": { "type": "string", "maxLength": 128 },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "receiptNo", "donorName", "amount", "method", "transactionId", "status", "createdAt", "updatedAt"]
    },
    "DonationContact": {
      "title": "DonationContact",
      "description": "Isolated PII contact info for donation receipts readable only by staff",
      "type": "object",
      "properties": {
        "donationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "contactInfo": { "type": "string", "maxLength": 200 },
        "submittedByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["donationId", "contactInfo", "createdAt"]
    },
    "Dua": {
      "title": "Dua",
      "description": "Authentic Quran and Sunnah dua or dhikr organized by occasion",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "occasion": { "type": "string", "enum": ["morning-evening", "sleep-wake", "salah-masjid", "daily-life", "distress-forgiveness"] },
        "occasionLabel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "title": { "type": "string", "minLength": 2, "maxLength": 240 },
        "arabic": { "type": "string", "minLength": 2, "maxLength": 4000 },
        "pronunciation": { "type": "string", "maxLength": 4000 },
        "translation": { "type": "string", "minLength": 2, "maxLength": 4000 },
        "reference": { "type": "string", "minLength": 1, "maxLength": 500 },
        "virtue": { "type": "string", "maxLength": 2000 },
        "targetCount": { "type": "number" },
        "featured": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "occasion", "occasionLabel", "title", "arabic", "translation", "reference", "targetCount", "createdAt", "updatedAt"]
    },
    "Masala": {
      "title": "Masala",
      "description": "Structured Islamic jurisprudence ruling (Mas'ala) organized by core topics like Salah, Siyam, Hajj, Zakat, Taharat, Talaq, and Qurbani",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "categoryId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "categoryName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "subTopic": { "type": "string", "minLength": 1, "maxLength": 120 },
        "title": { "type": "string", "minLength": 2, "maxLength": 240 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
        "content": { "type": "string", "minLength": 10, "maxLength": 30000 },
        "authorName": { "type": "string", "maxLength": 150 },
        "arabicReference": { "type": "string", "maxLength": 4000 },
        "quranHadithRefs": { "type": "string", "maxLength": 2000 },
        "featured": { "type": "boolean" },
        "order": { "type": "number" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "categoryId", "categoryName", "subTopic", "title", "summary", "content", "order", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles readable/writable only by owner or admins"
    },
    "/user_roles/{userId}": {
      "schema": { "$ref": "#/entities/UserRole" },
      "description": "Admin and editor RBAC role assignments"
    },
    "/admin_invites/{emailKey}": {
      "schema": { "$ref": "#/entities/AdminInvite" },
      "description": "Pre-authorized admin and editor role grants by email"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Islamic knowledge categories"
    },
    "/authors/{authorId}": {
      "schema": { "$ref": "#/entities/Author" },
      "description": "Islamic scholars and writers"
    },
    "/articles/{articleId}": {
      "schema": { "$ref": "#/entities/Article" },
      "description": "Islamic knowledge articles"
    },
    "/questions/{questionId}": {
      "schema": { "$ref": "#/entities/Question" },
      "description": "Islamic Q&A and fatwa entries"
    },
    "/question_contacts/{questionId}": {
      "schema": { "$ref": "#/entities/QuestionContact" },
      "description": "Private contact info of question submitters"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/Bookmark" },
      "description": "User saved articles and favorite questions"
    },
    "/users/{userId}/reading_history/{historyId}": {
      "schema": { "$ref": "#/entities/ReadingHistory" },
      "description": "User reading history"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Dynamic settings documents: site, prayer, donations, pages"
    },
    "/stats/{statId}": {
      "schema": { "$ref": "#/entities/SiteStats" },
      "description": "Site-wide visit counters"
    },
    "/page_views/{viewId}": {
      "schema": { "$ref": "#/entities/PageView" },
      "description": "Page view analytics log"
    },
    "/donations/{donationId}": {
      "schema": { "$ref": "#/entities/Donation" },
      "description": "Donation transaction records and official receipts"
    },
    "/donation_contacts/{donationId}": {
      "schema": { "$ref": "#/entities/DonationContact" },
      "description": "Private donor contact info isolated from public receipt reads"
    },
    "/duas/{duaId}": {
      "schema": { "$ref": "#/entities/Dua" },
      "description": "Authentic Quran and Sunnah supplications and dhikr"
    },
    "/masalas/{masalaId}": {
      "schema": { "$ref": "#/entities/Masala" },
      "description": "Topic-wise structured Islamic jurisprudence rulings (Mas'ala)"
    }
  }
}
